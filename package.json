{
  "name": "guia-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "astro dev --port 3000",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . && pnpm lint:tokens && pnpm lint:content && pnpm format:check",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "lint:content": "node scripts/lint-content.mjs",
    "typecheck": "astro check",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tokens:build": "node scripts/build-tokens.mjs",
    "figma:inspect": "node scripts/figma/inspect-node.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
