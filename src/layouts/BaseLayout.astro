---
import "@fontsource/instrument-serif/latin-400.css";
import "@fontsource/instrument-serif/latin-ext-400.css";
import "@fontsource/instrument-serif/latin-400-italic.css";
import "@fontsource/instrument-serif/latin-ext-400-italic.css";
import "@fontsource-variable/geist/wght.css";
import serifLatin from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";
import sansLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import "@/styles/global.css";
import {
  HTML_LANG,
  OG_LOCALE,
  SITE_NAME,
  SITE_URL,
  type Locale,
  type RouteName,
} from "@/config/site";
import { alternates, routePath } from "@/i18n";
import tokens from "../../design/tokens.local.json";

interface Props {
  locale: Locale;
  route: RouteName;
  title: string;
  description: string;
  /** For pages that must not be indexed: no canonical, no alternates, `noindex`. */
  noindex?: boolean;
}

const { locale, route, title, description, noindex = false } = Astro.props;
const pageTitle = `${SITE_NAME} | ${title}`;
const absolute = (path: string) => new URL(path, SITE_URL).href;
const canonical = absolute(routePath(route, locale));
---

<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content={tokens.color.dark.canvas}
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content={tokens.color.light.canvas}
      media="(prefers-color-scheme: light)"
    />
    <script is:inline src="/theme.js"></script>
    <script is:inline src="/menu.js" defer></script>
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {alternates(route).map((alternate) => (
          <link
            rel="alternate"
            hreflang={HTML_LANG[alternate.locale]}
            href={absolute(alternate.path)}
          />
        ))}
        <link rel="alternate" hreflang="x-default" href={absolute(routePath(route, "es"))} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <slot />
  </body>
</html>
